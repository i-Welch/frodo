{
  "name": "raven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:collect && next build",
    "start": "next start",
    "build:collect": "esbuild src/server/collect/frodo-collect.ts --bundle --minify --format=iife --outfile=public/frodo-collect.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "db:create": "bun scripts/create-tables.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:reset": "bun scripts/create-tables.ts && bun scripts/seed.ts",
    "pull-signups": "bun scripts/list-interest-signups.ts"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/html": "^1.4.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.3.2",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "eta": "^4.5.1",
    "googleapis": "^173.0.0",
    "jose": "^6.2.2",
    "next": "^16.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "puppeteer-core": "^24.42.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.0"
  }
}
