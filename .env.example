# Single Next.js app in dashboard/: the API runs inside it (src/server).
# Set these in Vercel (and in dashboard/.env.local for local dev).

# Neon Postgres connection string (pooled)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Base64-encoded 32 random bytes; wraps per-record data keys. Required in production/staging.
#   openssl rand -base64 32
MASTER_ENCRYPTION_KEY=
# Neon Auth base URL (project > Auth). The API verifies JWTs against <base>/.well-known/jwks.json
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
COOKIE_SECRET=
RAVEN_ADMIN_SECRET=
# Public origin of the deployed app (form links, webhooks)
BASE_URL=https://app.reportraven.tech
DASHBOARD_URL=https://app.reportraven.tech
# OTP + alert email (Resend) and SMS (Telnyx)
RESEND_API_KEY=
EMAIL_FROM=noreply@reportraven.tech
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

NEON_AUTH_COOKIE_SECRET=   # >= 32 characters
